{
  "name": "magazapos",
  "version": "1.0.0",
  "description": "POS ve Stok Yönetimi Sistemi (Giyim Mağazaları)",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "mkdir -p dist-electron/main/public && cp -r src/server/public/* dist-electron/main/public/ && vite",
    "dev:server": "tsx src/server/index.ts",
    "build": "mkdir -p dist-electron/main/public && cp -r src/server/public/* dist-electron/main/public/ && tsc && vite build",
    "test:api": "tsx scripts/test_system.ts",
    "package:win": "mkdir -p dist-electron/main/public && cp -r src/server/public/* dist-electron/main/public/ && tsc && vite build && electron-builder --win nsis",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "build": {
    "appId": "com.magazapos.app",
    "productName": "MağazaPOS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "prisma/**/*",
      ".env",
      "node_modules/@prisma/client/**/*",
      "node_modules/.prisma/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/.prisma/client/*.node",
      "**/node_modules/@prisma/client/*.node"
    ],
    "extraResources": [
      {
        "from": "prisma/dev.db",
        "to": "prisma/dev.db"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MağazaPOS Kasa ve Stok"
    }
  },
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "lucide-react": "^0.436.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^32.0.1",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.41",
    "prisma": "^5.19.0",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5"
  }
}
